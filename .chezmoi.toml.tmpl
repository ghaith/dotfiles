{{- /* Checks if running interactively, which is not the case for GitHub Codespaces */ -}}
{{- $ci := stdinIsATTY -}}
{{- $type := "server" -}}
{{- if (env "REMOTE_CONTAINERS") }}
{{-   $type = "devcontainer" -}}
{{- else if $ci }}
{{-   $type = promptStringOnce . "type" "Machine type (desktop/server/devcontainer)" -}}
{{- end }}
sourceDir = {{ .chezmoi.sourceDir | quote }}
{{ if eq .chezmoi.os "windows" }}
{{- /* Git Bash derives HOME from HOMEDRIVE, which on a corporate machine is a
       network share, while PowerShell uses USERPROFILE. Pin destDir so the
       apply target never depends on which shell chezmoi is invoked from. */}}
destDir = {{ env "USERPROFILE" | replace "\\" "/" | quote }}
{{ end }}

[data]
    interactive = {{ $ci }}
    type = {{ $type | quote }}
{{- if $ci }}
    name = {{ promptString "Git name" | quote }}
    email = {{ promptString "Git email" | quote }}
{{- else }}
    name = {{ env "GIT_NAME" | quote }}
    email = {{ env "GIT_EMAIL" | quote }}
{{- end }}

